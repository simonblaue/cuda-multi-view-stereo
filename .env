# =============================================================================
#  Per-host configuration for docker-compose.yml (the `cumvs` container).
#
#  Docker Compose reads this file automatically and substitutes the
#  ${VAR:-default} placeholders in docker-compose.yml.  It is tracked in git
#  so both hosts share the same layout; edit the values on each machine to
#  match that machine's GPU and (optionally) dataset mount.
#
#  Two supported hosts:
#    * "this" machine  : single NVIDIA GeForce GTX 1080 Ti -> CUDA_ARCH=61
#    * "L40" machine   : 3x NVIDIA L40 (Ada Lovelace)      -> CUDA_ARCH=89
#
#  IMPORTANT: CUDA_ARCH_BIN/PTX must match the host GPU.  Native SASS for one
#  architecture cannot run on another (an sm_89 build will not run on a 1080
#  Ti, and an sm_61 build will not run on an L40).  Change them together and
#  rebuild the image after changing them.
# =============================================================================

# Build pins (keep the same on both hosts unless you know why not).
CUDA_VERSION=12.4.1
UBUNTU_VERSION=22.04
OPENCV_VERSION=4.10.0

# GPU compute capability of the current host.
#   GTX 1080 Ti (Pascal, sm_61)   -> 61   (this machine)
#   3x L40 (Ada Lovelace, sm_89)  -> 89   (the L40 machine)
CUDA_ARCH_BIN=61
CUDA_ARCH_PTX=61

# Optional read-only data directory mounted at /Data inside the container.
# To attach a dataset on a given host, set the host path here (the volume in
# docker-compose.yml reads it).  On a host with no dataset, comment this line
# out and comment the matching volume line in docker-compose.yml.
DATA_MOUNT_SOURCE=/media/sblaue/RaidSL/ROS/RecordingsCompressed

# File ownership inside the container.  The entrypoint drops from root to this
# uid/gid so that files written into the repo (build/, output/, ...) belong to
# you on the host.  Leave all three unset to auto-detect the owner of the
# mounted /workspace/cumvs directory (normally the user who invoked docker).
# Override here (or with `-e CUMVS_UID=...`) to force specific ids.
# CUMVS_UID=1000
# CUMVS_GID=1000
# CUMVS_USER=appuser
